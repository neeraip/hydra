; Prioritised control rules on an orifice, with a named variable.
[OPTIONS]
FLOW_UNITS  CFS

[JUNCTIONS]
J1  100  6

[OUTFALLS]
O1  97  FREE

[ORIFICES]
R1  J1  O1  SIDE  0.5  0.65  NO  0

[XSECTIONS]
R1  CIRCULAR  1  0  0  0

[CONTROLS]
VARIABLE  D1 = NODE J1 DEPTH
RULE  DRAIN_HIGH
IF    NODE J1 DEPTH > 4
THEN  ORIFICE R1 SETTING = 1.0
PRIORITY  2
RULE  DRAIN_LOW
IF    NODE J1 DEPTH <= 4
THEN  ORIFICE R1 SETTING = 0.25
PRIORITY  1
